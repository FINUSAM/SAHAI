<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and phone-to-phone transfer rules for Android 12 and higher
     (PRD 3, tech plan, Auto Backup). The same files as backup_rules.xml,
     which Android 11 and lower use; see the notes there. Once any <include>
     is present only what is included is copied, so the -shm file and the
     pre-migration/ copies stay out. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/sahai.sqlite" />
        <include domain="root" path="app_flutter/sahai.sqlite-wal" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/sahai.sqlite" />
        <include domain="root" path="app_flutter/sahai.sqlite-wal" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
